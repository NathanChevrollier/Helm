# Discord Developer Portal
DISCORD_TOKEN=
CLIENT_ID=
# Serveur de développement/production où les commandes sont enregistrées immédiatement.
GUILD_ID=

# GitHub fine-grained token: accès Issues en lecture/écriture uniquement sur le dépôt ciblé.
GITHUB_TOKEN=
GITHUB_OWNER=NathanChevrollier
GITHUB_REPO=Helm
# Optionnel: numéro du GitHub Project v2. S'il est défini, les colonnes du projet sont utilisées directement.
GITHUB_PROJECT_NUMBER=

# IDs des salons où /setup-feedback publie les panneaux.
# Active le mode développeur Discord, clic droit sur chaque salon, puis « Copier l'identifiant ».
SUGGESTION_CHANNEL_ID=
BUG_CHANNEL_ID=

# Salon du panneau roadmap. Laisser vide pour désactiver la synchronisation automatique.
ROADMAP_CHANNEL_ID=
# Facultatif: ID du message roadmap déjà créé. Sinon le bot le retrouve dans les 50 derniers messages.
ROADMAP_MESSAGE_ID=
ROADMAP_SYNC_INTERVAL_MINUTES=15

# Labels GitHub utilisés pour les issues créées par le bot.
GITHUB_BUG_LABEL=bug
GITHUB_SUGGESTION_LABEL=enhancement
GITHUB_BRAINSTORMING_LABEL=brainstorming
GITHUB_IN_PROGRESS_LABEL=in-progress
GITHUB_TEST_LABEL=test
GITHUB_DONE_LABEL=done
NODE_ENV=production
