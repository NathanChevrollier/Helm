{
  "name": "zenytt",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter zenytt-desktop tauri dev",
    "build": "pnpm --filter zenytt-desktop tauri build",
    "release": "node scripts/release.mjs",
    "build:agent": "cargo zigbuild -p zenyttd --release --target x86_64-unknown-linux-musl --target aarch64-unknown-linux-musl",
    "typecheck": "pnpm --filter zenytt-desktop exec tsc --noEmit",
    "test": "cargo test --workspace && pnpm --filter zenytt-desktop test",
    "testenv": "docker compose -f testenv/docker-compose.yml up -d --build"
  },
  "packageManager": "pnpm@12.5.1"
}
